# Load with: set -a; source .env; set +a
# Required scene data and language annotations
AMBIREFER3D_DATA_ROOT=/path/to/preprocessed_dataset
SCANNET_RAW_ROOT=/path/to/scannet/scans
SCANNET_LABEL_MAP=/path/to/scannetv2-labels.combined.tsv
SCANNET_MULTIVIEW_FILE=/path/to/enet_feats_maxpool.hdf5
AMBIREFER3D_OUTPUT_ROOT=output
MT_SOURCE_TRAIN_JSON=/path/to/ambiguous_train.json
MT_SOURCE_VAL_JSON=/path/to/ambiguous_val.json
INIT_CKPT=/path/to/pretrained_grounding.ckpt
STAGE1_CKPT=/path/to/finetuned_stage1.ckpt

# Independent Stage 2 training/evaluation with actual candidate IDs
STAGE2_TRAIN_JSON=/path/to/train_rounds.json
STAGE2_VAL_JSON=/path/to/val_rounds.json
STAGE2_IMG_CACHE=/path/to/imgfeat_cache
STAGE2_CKPT=/path/to/stage2.pt
STAGE2_SPEC=/path/to/spec.json

# Shared OpenAI-compatible LLM/VLM API configuration
AMBIREFER3D_API_KEY=EMPTY
AMBIREFER3D_TEXT_API_BASE=http://localhost:8200/v1
AMBIREFER3D_VISION_API_BASE=http://localhost:8100/v1
AMBIREFER3D_TEXT_MODEL=qwen-llm
AMBIREFER3D_VISION_MODEL=qwen-vl

# Real scene construction (input descriptions, upstream scene graph and cameras)
AMBIREFER3D_REAL_INPUT_JSON=/path/to/scanrefer_descriptions.json
AMBIREFER3D_REAL_RENDER_CSV=/path/to/descriptions.csv
AMBIREFER3D_REAL_SCENEGRAPH_ROOT=/path/to/scenegraph
AMBIREFER3D_REAL_CAMERA_ROOT=/path/to/annotated_cameras
AMBIREFER3D_REAL_RENDER_ROOT=/path/to/render
AMBIREFER3D_REAL_AMBIGUOUS_JSONL=data/real/ambiguous_queries.jsonl
AMBIREFER3D_REAL_AMBIGUOUS_JSON=data/real/ambiguous_queries.json
AMBIREFER3D_REAL_FILTERED_JSON=data/real/filtered_queries.json
AMBIREFER3D_REAL_DIALOGUES_JSONL=data/real/dialogues.jsonl
AMBIREFER3D_REAL_ERROR_LOG=output/ambirefer3d_data/real_errors.txt

# Licensed synthetic assets; these are not included
FRONT_DIR=/path/to/3D-FRONT-jsons
FUTURE_FOLDER=/path/to/3D-FUTURE-models
FRONT_TEXTURE_ROOT=/path/to/3D-FRONT-textures
FRONT_MODEL_INFO=/path/to/model_info.json
CC_MATERIAL_ROOT=/path/to/cc_materials
SYNTHETIC_OUTPUT_ROOT=/path/to/generated_scenes
AMBIREFER3D_SYNTHETIC_RENDER_ROOT=/path/to/render_multiview

CUDA_VISIBLE_DEVICES=0
DEVICES=1
MAX_EPOCHS=20
BATCH_SIZE=4
